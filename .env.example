# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: llm-gateway-observability
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Deterministic mock gateway with in-process trace recorder.
#
# TIER 2 / TIER 3: LIVE OPENAI / ANTHROPIC & OTEL COLLECTOR
# - Set API keys and OpenTelemetry exporter endpoints.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OTLP_TRACE_URL=http://localhost:4318/v1/traces
OTLP_METRIC_URL=http://localhost:4318/v1/metrics
PORT=3000
